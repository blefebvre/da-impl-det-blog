{
  "templates": [
    {
      "name": "blog-post",
      "description": "Blog article: title, date, author, read time, body with code/images, share link, author bio, comments",
      "urls": [
        "https://implementationdetails.dev/blog/2013/06/20/cqcon-2013-mobile-first/",
        "https://implementationdetails.dev/blog/2013/08/22/setting-up-a-dispatcher-on-os-x/",
        "https://implementationdetails.dev/blog/2013/08/28/evolve-2013-cq-mobile-apps/",
        "https://implementationdetails.dev/blog/2013/09/18/cq-gems-mobile-first-development/",
        "https://implementationdetails.dev/blog/2014/03/14/so-you-want-to-build-an-app/",
        "https://implementationdetails.dev/blog/2014/04/10/aemhub-mobile-apps-in-aem/",
        "https://implementationdetails.dev/blog/2014/05/30/mobile-apps-made-and-managed-in-aem/",
        "https://implementationdetails.dev/blog/2014/06/06/iot-day-in-ottawa/",
        "https://implementationdetails.dev/blog/2014/08/24/adaptto-2014-mobile-apps/",
        "https://implementationdetails.dev/blog/2014/09/23/adaptto-2014-mobile-app-dev-with-cordova/",
        "https://implementationdetails.dev/blog/2014/11/17/aem-apps-featurepack-updates/",
        "https://implementationdetails.dev/blog/2015/02/05/summit-2015-mobile-app-dev-and-content-management-with-aem/",
        "https://implementationdetails.dev/blog/2015/06/18/aem-6-dot-1-apps-starter-kit-improvements/",
        "https://implementationdetails.dev/blog/2015/08/19/using-ssl-locally-for-aem-development/",
        "https://implementationdetails.dev/blog/2015/10/14/debugging-an-aem-app/",
        "https://implementationdetails.dev/blog/2017/03/10/build-an-app-with-content-services-at-adobe-summit-2017/",
        "https://implementationdetails.dev/blog/2018/10/12/react-native-typescript-cocoapods/",
        "https://implementationdetails.dev/blog/2018/11/06/react-native-offline-first-db-with-sqlite/",
        "https://implementationdetails.dev/blog/2018/12/05/sync-react-native-sqlite-db-with-dropbox/",
        "https://implementationdetails.dev/blog/2019/01/31/dealing-with-monetary-values-react-native/",
        "https://implementationdetails.dev/blog/2019/03/03/upgrading-react-native-with-rn-diff-purge/",
        "https://implementationdetails.dev/blog/2019/04/03/react-native-upgrade-by-example/",
        "https://implementationdetails.dev/blog/2019/04/28/react-ottawa-dealing-with-monetary-values/",
        "https://implementationdetails.dev/blog/2019/06/02/react-native-responsive-table-with-hooks/",
        "https://implementationdetails.dev/blog/2019/06/27/sqlite-dates-in-react-native/",
        "https://implementationdetails.dev/blog/2019/07/29/tidy-sqlite-statements-with-js-template-literals/",
        "https://implementationdetails.dev/blog/2019/08/26/cypress-gotchas-with-promises/",
        "https://implementationdetails.dev/blog/2019/09/30/react-native-version-mismatch/",
        "https://implementationdetails.dev/blog/2019/10/27/a-month-with-python/",
        "https://implementationdetails.dev/blog/2019/11/26/typescript-react-native-paper/",
        "https://implementationdetails.dev/blog/2019/12/30/basic-spa-with-deep-linking-and-analytics/",
        "https://implementationdetails.dev/blog/2020/05/03/react-native-offline-first-db-with-sqlite-hooks/",
        "https://implementationdetails.dev/blog/2020/08/13/get-to-know-the-aem-dispatcher/",
        "https://implementationdetails.dev/blog/2020/09/30/stepping-through-the-sling-engine-source/",
        "https://implementationdetails.dev/blog/2021/01/31/macos-existing-react-native-app-gotchas/",
        "https://implementationdetails.dev/blog/2021/03/08/meet-the-aem-dispatcher-optimizer-tool/",
        "https://implementationdetails.dev/blog/2021/08/05/ctt-extraction-deep-dive/",
        "https://implementationdetails.dev/blog/2023/10/17/aem-trial-whats-in-the-box/"
      ],
      "representativeUrl": "https://implementationdetails.dev/blog/2018/11/06/react-native-offline-first-db-with-sqlite/",
      "blocks": [
        {
          "name": "embed",
          "instances": [
            "article.post-content iframe"
          ]
        }
      ],
      "urlPattern": "/blog/*",
      "sections": [
        {
          "id": "rc1",
          "name": "post-header",
          "selector": [
            "div.post-header",
            ".measure > .post-header"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "div.post-header h1"
          ]
        },
        {
          "id": "rc2",
          "name": "article-body",
          "selector": [
            "article.post-content"
          ],
          "style": null,
          "blocks": [
            "embed"
          ],
          "defaultContent": [
            "article.post-content > *"
          ]
        }
      ]
    },
    {
      "name": "blog-listing",
      "description": "Homepage listing of blog posts (4 per page, newest first) with Newer/Older pagination",
      "urls": [
        "https://implementationdetails.dev/"
      ],
      "representativeUrl": "https://implementationdetails.dev/",
      "blocks": [
        {
          "name": "blog-list",
          "instances": [
            "div.home div.posts"
          ]
        }
      ],
      "urlPattern": "/",
      "sections": [
        {
          "id": "rc1",
          "name": "post-listing",
          "selector": [
            "div.home"
          ],
          "style": null,
          "blocks": [
            "blog-list"
          ],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "simple-page",
      "description": "Simple content page with a heading and body (contact form, thank-you message)",
      "urls": [
        "https://implementationdetails.dev/contact/",
        "https://implementationdetails.dev/thanks/"
      ],
      "representativeUrl": "https://implementationdetails.dev/contact/",
      "blocks": [
        {
          "name": "contact-form",
          "instances": [
            "article.post-content form"
          ]
        }
      ],
      "urlPattern": "/*",
      "sections": [
        {
          "id": "rc1",
          "name": "page-content",
          "selector": [
            "div.post"
          ],
          "style": null,
          "blocks": [
            "contact-form"
          ],
          "defaultContent": [
            "header.post-header h1",
            "article.post-content > p"
          ]
        }
      ]
    }
  ],
  "metadata": {
    "projectType": "da"
  }
}
